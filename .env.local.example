# Anthropic API Key (Claude)
ANTHROPIC_API_KEY=

# OpenAI API Key (ChatGPT)
OPENAI_API_KEY=

# Google AI API Key (Gemini)
GOOGLE_AI_API_KEY=

# Ollama Base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# 検索プロバイダー設定
# 複数設定可能。優先順位: Tavily > SearXNG > Serper > Brave > DuckDuckGo
# ============================================

# Tavily API Key (AI向け最適化検索、推奨)
# https://tavily.com/
TAVILY_API_KEY=

# SearXNG Base URL (セルフホスト型メタ検索エンジン)
SEARXNG_BASE_URL=http://localhost:8080

# Serper API Key (Google検索結果をAPI経由で取得)
# https://serper.dev/
SERPER_API_KEY=

# Brave Search API Key (独自インデックスのプライバシー検索)
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# DuckDuckGo: APIキー不要、常に利用可能（フォールバック）

# ============================================
# ページ詳細取得
# ============================================

# Jina Reader API Key (ページ詳細取得機能を使用する場合、任意)
# なしでも20 RPM、ありで500 RPM
JINA_API_KEY=
